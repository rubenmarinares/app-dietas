{
    "name": "brigantia/skeleton",
    "description": "Esqueleto PHP (FastRoute + Twig + PDO + ModelBase/dbschema) con login, 2FA, usuarios y permisos.",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "authors": [
        {
            "name": "Bruno Fernández"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "spomky-labs/otphp": "^11.4.3",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "aws/aws-sdk-php": "^3.319",
        "mpdf/mpdf": "^8.2",
        "bacon/bacon-qr-code": "^3.0",
        "php-debugbar/php-debugbar": "^2.1",
        "ezyang/htmlpurifier": "^4.17",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

# Copia este fichero a .env y rellena los valores. El .env NUNCA se versiona.
# Las variables reales del entorno (servidor web, systemd…) tienen prioridad sobre este fichero.

# --- Aplicación ---
APP_NAME=redGDPS
# 1 = muestra errores y DebugBar. NUNCA en producción.
APP_DEBUG=0
APP_TIMEZONE=Europe/Madrid
# Días de gracia para configurar 2FA que se dan a un usuario nuevo o tras resetear su 2FA.
TWOFA_GRACE_DAYS=7

# --- Rutas (los valores por defecto sirven para una instalación en la raíz del dominio) ---
# LOCAL_PATH=/ruta/absoluta/al/proyecto/src/
# PUBLIC_PATH=/
# APP_PATH=/app/
# LOCAL_UPLOAD_PATH=/ruta/absoluta/al/proyecto/uploads/
# PUBLIC_UPLOAD_PATH=/uploads/

# --- Base de datos (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=redgdps_cms
DB_USER=usuario
DB_PASS=cambiar

# --- SMTP (códigos 2FA por email y cualquier correo saliente) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ejemplo.com
SMTP_FROMNAME=redGDPS
# Dirección de contacto del sistema (no hardcodear en código)
SYSTEM_CONTACT_EMAIL=

# --- Almacenamiento S3 (opcional, Core\Storage::disk('s3') y Core\S3FILE) ---
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_REGION=eu-west-1

# --- Almacenamiento FTP (opcional, Core\Storage::disk('ftp')) ---
STORAGE_FTP_HOST=
STORAGE_FTP_USER=
STORAGE_FTP_PASSWORD=
STORAGE_FTP_ROOT=/
STORAGE_FTP_SSL=0

# --- Despliegue por FTP (tools/deploy.php). Ojo: la clave es FTP_PASSWORD, no FTP_PASS ---
FTP_HOST=ftp.ejemplo.com
FTP_PORT=21
FTP_USER=usuario
FTP_PASSWORD=secreto
# Carpeta remota equivalente a la raíz del repo
FTP_ROOT=/httpdocs
# 1 = FTPS explícito, 0 = FTP sin cifrar
FTP_SSL=1
FTP_PATHS=src/,public/,.htaccess
